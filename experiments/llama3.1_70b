# arabic with 3.1
# context added

import json
from openai import OpenAI
from tqdm import tqdm
import re
import random
from typing import List, Dict, Tuple
from datetime import datetime

# Configuration
MODEL_NAME = "llama3.1:70b"
POEMS_FILE = "arabic_150_modified.json"
METRICS_FILE = "arabic_metric.json"
OUTPUT_FILE = "arabic_results_8.json"
MAX_TOKENS = 200  # Limit poem length

# Ollama Client Setup
client = OpenAI(
    base_url='http://localhost:11436/v1',
    api_key='ollama',
    timeout=60.0  # 增加超时时间
)

class Poem:
    def __init__(self, text, metric_name):
        self.text = text[:MAX_TOKENS]  # Take first 200 tokens
        self.metric_name = metric_name

def load_data():
    """Load poems and metrics data with validation"""
    with open(POEMS_FILE, 'r', encoding='utf-8') as f:
        poems_data = json.load(f)
    
    with open(METRICS_FILE, 'r', encoding='utf-8') as f:
        metrics_data = json.load(f)
    
    poems = []
    for item in poems_data:
        text = item.get("Text", "").strip()
        metric = item.get("PoemMetric", "").strip()
        if text and metric:
            poems.append(Poem(text, metric))
        else:
            print(f"跳过无效数据: Text={text[:30]}..., Metric={metric}")
    
    return poems, metrics_data

def generate_options(correct_pattern: str, all_metrics: Dict[str, str]) -> Tuple[List[Dict], str]:
    """Generate randomized options with validation"""
    # Ensure incorrect patterns are truly different
    incorrect_pool = list(set(v for v in all_metrics.values() if v != correct_pattern))
    
    if not incorrect_pool:
        incorrect_pool = ["unknown_meter"] * 3
    
    # Ensure we don't sample duplicates
    sampled_incorrect = random.sample(incorrect_pool * 3, 3)  # Allow repetition only if necessary
    
    labels = ['A', 'B', 'C', 'D']
    correct_pos = random.randint(0, 3)
    options = []
    
    for i, label in enumerate(labels):
        pattern = correct_pattern if i == correct_pos else sampled_incorrect.pop()
        options.append({
            "label": label,
            "pattern": pattern,
            "is_correct": i == correct_pos
        })
    
    return options, labels[correct_pos]

def create_prompt(poem_text: str, options: List[Dict]) -> str:
    """Enhanced structured prompt with clear task decomposition"""
    options_text = "\n".join(f"{opt['label']}. {opt['pattern']}" for opt in options)
    
    return f"""
**Arabic Poetry Meter Identification Task**

**Instructions:**
1. Carefully read the provided poem
2. Analyze its rhythmic structure syllable by syllable
3. Compare with the given meter options
4. Select the most appropriate meter pattern

**Key Considerations:**
- Focus on the poem's *tafāʿīl* (تفاعيل) patterns
- Count the syllables in each verse
- Match the recurring rhythmic units to known meters

**Common Arabic Meters (for reference):**
1. Ṭawīl (طويل): Faʿūlun Mafāʿīlun Faʿūlun Mafāʿilun
2. Basīṭ (بسيط): Mustafʿilun Fāʿilun Mustafʿilun Faʿilun
3. Kāmil (كامل): Mutafāʿilun (repeated)
4. Hazaj (هزج): Mafāʿīlun (repeated)
5. Rajaz (رجز): Mustafʿilun (repeated)
6. Mutaqārib (متقارب): Faʿūlun (repeated)

**Poem to Analyze:**
{poem_text}

**Meter Options:**
{options_text}

**Response Format:**
<ANALYSIS>
- [Brief technical analysis of the poem's rhythm]
- [Comparison with each option's pattern]
- [Elimination of incorrect options]
</ANALYSIS>

<FINAL>[A/B/C/D]</FINAL>

**Important Notes:**
- You MUST output in the exact specified format
- Choose ONLY ONE option label (A-D)
- Keep analysis concise but technically accurate"""


def parse_output(output: str) -> str:
    """More flexible output parsing"""
    patterns = [
        r"<FINAL>\s*\[([A-D])\]",
        r"<FINAL>\s*([A-D])",
        r"选择\s*([A-D])",
        r"答案\s*:\s*([A-D])",
        r"\b([A-D])\b(?!.*\b\1\b)"  # Standalone letter
    ]
    
    for pattern in patterns:
        if match := re.search(pattern, output, re.IGNORECASE):
            return match.group(1).upper()
    
    raise ValueError(f"Invalid output format: {output[:200]}...")

def process_poem(poem: Poem, metrics: Dict[str, str]) -> Dict:
    """Enhanced processing with detailed logging"""
    try:
        correct_pattern = metrics.get(poem.metric_name)
        if not correct_pattern:
            raise ValueError(f"未找到格律模式: {poem.metric_name}")
        
        options, correct_label = generate_options(correct_pattern, metrics)
        prompt = create_prompt(poem.text, options)
        
        response = client.chat.completions.create(
            model=MODEL_NAME,
            messages=[{"role": "user", "content": prompt}],
            temperature=0.2,
            max_tokens=250,
            stop=["</FINAL>"]
        )
        output = response.choices[0].message.content
        predicted_label = parse_output(output)
        
        return {
            "metadata": {
                "model": MODEL_NAME,
                "timestamp": datetime.now().isoformat(),
                "prompt_version": "v2.1"
            },
            "poem_text": poem.text,
            "prompt": prompt,
            "options": options,
            "correct_label": correct_label,
            "predicted_label": predicted_label,
            "is_correct": predicted_label == correct_label,
            "raw_output": output
        }
    except Exception as e:
        return {
            "poem_text": poem.text,
            "error": str(e),
            "correct_metric": poem.metric_name,
            "options": options if 'options' in locals() else None
        }

def main():
    poems, metrics = load_data()
    results = []
    
    for poem in tqdm(poems, desc="Processing poems"):
        result = process_poem(poem, metrics)
        results.append(result)
        
        if len(results) % 10 == 0:
            valid = [r for r in results if 'error' not in r]
            accuracy = sum(r['is_correct'] for r in valid) / len(valid) if valid else 0
            print(f"Progress: {len(results)}/{len(poems)} | Accuracy: {accuracy:.1%}")

    # Calculate final stats
    successful = [r for r in results if 'error' not in r]
    accuracy = sum(r['is_correct'] for r in successful) / len(successful) if successful else 0
    
    # Enhanced output structure
    output_data = {
        "summary": {
            "total_poems": len(results),
            "successful": len(successful),
            "failed": len(results) - len(successful),
            "accuracy": accuracy,
            "model": MODEL_NAME,
            "date": datetime.now().isoformat()
        },
        "results": results
    }
    
    with open(OUTPUT_FILE, 'w', encoding='utf-8') as f:
        json.dump(output_data, f, indent=2, ensure_ascii=False)
    
    print(f"\n✅ 完成! 准确率: {accuracy:.1%} | 成功: {len(successful)} | 失败: {len(results)-len(successful)}")
    if len(results) - len(successful) > 0:
        print("失败案例:", [r['poem_text'][:30]+"..." for r in results if 'error' in r][:3])

if __name__ == "__main__":
    main()

# persian
import json
from openai import OpenAI
from tqdm import tqdm
import re
import random
from typing import List, Dict, Tuple
from datetime import datetime

# Configuration
MODEL_NAME = "llama3.1:70b"
POEMS_FILE = "persian_261_modified.json"
METRICS_FILE = "persian_metric.json"
OUTPUT_FILE = "perisan_results_2.json"
MAX_TOKENS = 200  # Limit poem length

# Ollama Client Setup
client = OpenAI(
    base_url='http://localhost:11435/v1',
    api_key='ollama',
    timeout=60.0  # 增加超时时间
)

class Poem:
    def __init__(self, text, metric_name):
        self.text = text[:MAX_TOKENS]  # Take first 200 tokens
        self.metric_name = metric_name

def load_data():
    """Load poems and metrics data with validation"""
    with open(POEMS_FILE, 'r', encoding='utf-8') as f:
        poems_data = json.load(f)
    
    with open(METRICS_FILE, 'r', encoding='utf-8') as f:
        metrics_data = json.load(f)
    
    poems = []
    for item in poems_data:
        text = item.get("Text", "").strip()
        metric = item.get("PoemMetric", "").strip()
        if text and metric:
            poems.append(Poem(text, metric))
        else:
            print(f"跳过无效数据: Text={text[:30]}..., Metric={metric}")
    
    return poems, metrics_data

def generate_options(correct_pattern: str, all_metrics: Dict[str, str]) -> Tuple[List[Dict], str]:
    """Generate randomized options with validation"""
    # Ensure incorrect patterns are truly different
    incorrect_pool = list(set(v for v in all_metrics.values() if v != correct_pattern))
    
    if not incorrect_pool:
        incorrect_pool = ["unknown_meter"] * 3
    
    # Ensure we don't sample duplicates
    sampled_incorrect = random.sample(incorrect_pool * 3, 3)  # Allow repetition only if necessary
    
    labels = ['A', 'B', 'C', 'D']
    correct_pos = random.randint(0, 3)
    options = []
    
    for i, label in enumerate(labels):
        pattern = correct_pattern if i == correct_pos else sampled_incorrect.pop()
        options.append({
            "label": label,
            "pattern": pattern,
            "is_correct": i == correct_pos
        })
    
    return options, labels[correct_pos]

def create_prompt(poem_text: str, options: List[Dict]) -> str:
    """Enhanced prompt with clearer instructions"""
    options_text = "\n".join(f"{opt['label']}. {opt['pattern']}" for opt in options)
    
    return f"""
You are an Persian poetry expert. Your task is to choose the right meter for the given poem. Before you make the final decision,
go through the follwing instractions:

1. Consider the Meter Information: 
u = a short syllable
– = a long syllable
–u = an overlong syllable
x = anceps, that is: some metres allow either a long or short syllable at the beginning of a line.
u u = biceps, that is, a pair of short syllables that can be freely replaced by one long syllable. Mainly this occurs when a line ends in u u –, rarely elsewhere.

About 30 different metres are commonly used for lyric poems, but 70% of the poems are written in one of the following seven metres:[9]

u – u – | u u – – | u – u – | u u – (15 syllables)
– – | u – u – | u u – – | u – u – (14 syllables)
– u – – | – u – – | – u – – | – u – (15 syllables)
x u – – | u u – – | u u – – | u u – (15 syllables)
x u – – | u – u – | u u – (11 syllables)
u – – – | u – – – | u – – – | u – – – (16 syllables)
– – | u u – – | u u – – | u u – – (14 syllables)

2. Analyze the poem's syllabic structure
3. Match to one of the given meter patterns
4. Respond STRICTLY in this format:

<ANALYSIS>
- [Brief reasoning in 1-2 lines]
</ANALYSIS>

<FINAL>[A/B/C/D]</FINAL>

## Poem:
{poem_text}

## Options:
{options_text}

## Important:
- You MUST choose only one option
- Do NOT explain beyond the required format"""

def parse_output(output: str) -> str:
    """More flexible output parsing"""
    patterns = [
        r"<FINAL>\s*\[([A-D])\]",
        r"<FINAL>\s*([A-D])",
        r"选择\s*([A-D])",
        r"答案\s*:\s*([A-D])",
        r"\b([A-D])\b(?!.*\b\1\b)"  # Standalone letter
    ]
    
    for pattern in patterns:
        if match := re.search(pattern, output, re.IGNORECASE):
            return match.group(1).upper()
    
    raise ValueError(f"Invalid output format: {output[:200]}...")

def process_poem(poem: Poem, metrics: Dict[str, str]) -> Dict:
    """Enhanced processing with detailed logging"""
    try:
        correct_pattern = metrics.get(poem.metric_name)
        if not correct_pattern:
            raise ValueError(f"未找到格律模式: {poem.metric_name}")
        
        options, correct_label = generate_options(correct_pattern, metrics)
        prompt = create_prompt(poem.text, options)
        
        response = client.chat.completions.create(
            model=MODEL_NAME,
            messages=[{"role": "user", "content": prompt}],
            temperature=0.2,
            max_tokens=250,
            stop=["</FINAL>"]
        )
        output = response.choices[0].message.content
        predicted_label = parse_output(output)
        
        return {
            "metadata": {
                "model": MODEL_NAME,
                "timestamp": datetime.now().isoformat(),
                "prompt_version": "v2.1"
            },
            "poem_text": poem.text,
            "prompt": prompt,
            "options": options,
            "correct_label": correct_label,
            "predicted_label": predicted_label,
            "is_correct": predicted_label == correct_label,
            "raw_output": output
        }
    except Exception as e:
        return {
            "poem_text": poem.text,
            "error": str(e),
            "correct_metric": poem.metric_name,
            "options": options if 'options' in locals() else None
        }

def main():
    poems, metrics = load_data()
    results = []
    
    for poem in tqdm(poems, desc="Processing poems"):
        result = process_poem(poem, metrics)
        results.append(result)
        
        if len(results) % 10 == 0:
            valid = [r for r in results if 'error' not in r]
            accuracy = sum(r['is_correct'] for r in valid) / len(valid) if valid else 0
            print(f"Progress: {len(results)}/{len(poems)} | Accuracy: {accuracy:.1%}")

    # Calculate final stats
    successful = [r for r in results if 'error' not in r]
    accuracy = sum(r['is_correct'] for r in successful) / len(successful) if successful else 0
    
    # Enhanced output structure
    output_data = {
        "summary": {
            "total_poems": len(results),
            "successful": len(successful),
            "failed": len(results) - len(successful),
            "accuracy": accuracy,
            "model": MODEL_NAME,
            "date": datetime.now().isoformat()
        },
        "results": results
    }
    
    with open(OUTPUT_FILE, 'w', encoding='utf-8') as f:
        json.dump(output_data, f, indent=2, ensure_ascii=False)
    
    print(f"\n✅ 完成! 准确率: {accuracy:.1%} | 成功: {len(successful)} | 失败: {len(results)-len(successful)}")
    if len(results) - len(successful) > 0:
        print("失败案例:", [r['poem_text'][:30]+"..." for r in results if 'error' in r][:3])

if __name__ == "__main__":
    main()


